{
  "name": "sce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "Estoquista"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names master,estoquista --prefix-colors blue,green \"npm run dev:master\" \"npm run dev:estoquista\"",
    "build": "npm run build:master && npm run build:estoquista",
    "lint": "npm run lint:master && npm run lint:estoquista",
    "preview": "vite preview",
    "start": "npm run dev",
    "dev:master": "npm --prefix . run vite:master",
    "dev:estoquista": "npm --prefix Estoquista run dev",
    "vite:master": "vite --host 0.0.0.0 --port 5173",
    "build:master": "vite build",
    "build:estoquista": "npm --prefix Estoquista run build",
    "lint:master": "eslint .",
    "lint:estoquista": "npm --prefix Estoquista run lint"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "shadcn": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
